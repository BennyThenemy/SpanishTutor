# Firebase web app config (Project settings → Your apps → Web app).
# Enable "Firebase AI Logic" with the Gemini Developer API in the Firebase console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required when App Check is enforced for AI Logic).
# Local testing: Firebase console → App Check → Apps → your web app → ⋮ → Manage debug tokens → Add.
VITE_APPCHECK_DEBUG_TOKEN=
# Production: reCAPTCHA Enterprise site key registered for the web app in App Check.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Optional model overrides.
# VITE_LIVE_MODEL=gemini-3.1-flash-live-preview
# VITE_CHECKER_MODEL=gemini-3.5-flash-lite
